ARTIFACTORY_IMAGE=releases-docker.jfrog.io/jfrog/artifactory-cpp-ce:7.63.12
ARTIFACTORY_CONTAINER_NAME=terminus-artifactory
ARTIFACTORY_DATA_DIR=${HOME}/.terminus/artifactory/var
ARTIFACTORY_PORT=8081
ARTIFACTORY_ROUTER_PORT=8082
ARTIFACTORY_CONAN_REPOSITORY=conan-local
ARTIFACTORY_CONAN_REMOTE=terminus-local
